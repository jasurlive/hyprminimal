{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "notification-window-width": 480,
  "control-center-width": 420,
  "control-center-margin-top": 8,
  "control-center-margin-right": 4,
  "control-center-margin-left": 0,
  "control-center-margin-bottom": 8,
  "notification-icon-size": 44,
  "notification-body-image-height": 120,
  "notification-body-image-width": 200,
  "notification-inline-replies": true,
  "timeout": 3,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-height": -1,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 0,
  "hide-on-clear": false,
  "hide-on-action": true,
  "widgets": [
    "buttons-grid#info",
    "buttons-grid",
    "buttons-grid#power",
    "mpris",
    "buttons-grid#notif",
    "notifications"
  ],
  "widget-config": {
    "buttons-grid#notif": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰂚   Notifications   󰅀",
          "command": "sh -c 'f=$XDG_RUNTIME_DIR/hyprminimal/cc/expanded; [ -e \"$f\" ] && rm -f \"$f\" || : > \"$f\"'"
        },
        {
          "label": "Clear all",
          "command": "swaync-client -C"
        }
      ]
    },
    "notifications": {
      "vexpand": false
    },
    "mpris": {
      "image-size": 48,
      "blur": false,
      "blacklist": [
        "playerctld"
      ]
    },
    "buttons-grid#info": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰖩   Wi-Fi",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c 'nmcli radio wifi | grep -q enabled && echo true || echo false'"
        },
        {
          "label": "󰅂",
          "command": "sh -c 'swaync-client -cp; hyprminimal-msg panel wifi'"
        },
        {
          "label": "󰓅   System",
          "command": "sh -c 'swaync-client -cp; hyprminimal-msg panel system'"
        }
      ]
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰂯\nBluetooth",
          "type": "toggle",
          "command": "hyprminimal-msg bluetooth",
          "update-command": "hyprminimal-msg bluetooth-state"
        },
        {
          "label": "󰅶\nCaffeine",
          "type": "toggle",
          "command": "hyprminimal-msg caffeine",
          "update-command": "hyprminimal-msg caffeine-state"
        },
        {
          "label": "󰖔\nNight Light",
          "type": "toggle",
          "command": "hyprminimal-msg nightlight",
          "update-command": "hyprminimal-msg nightlight-state"
        },
        {
          "label": "󰂛\nSilent",
          "type": "toggle",
          "command": "swaync-client -d -sw",
          "update-command": "swaync-client -D -sw"
        }
      ]
    },
    "buttons-grid#power": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰌾  Lock",
          "command": "sh -c 'swaync-client -cp; hyprminimal-msg lock'"
        },
        {
          "label": "󰑓  Reboot",
          "command": "systemctl reboot"
        },
        {
          "label": "󰐥  Shut Down",
          "command": "systemctl poweroff"
        }
      ]
    }
  }
}
