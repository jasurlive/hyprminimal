/* hyprminimal launcher: minimal numbered list (scripts/launcher.py). Search on top,
   one line per app, dim numbers, last used app pinned first. */
@import "theme.rasi"

configuration {
    sort:     false;     /* keep alphabetical order (and app numbers) while searching */
    matching: "normal";
}

window {
    /* top right like every hyprminimal popup: 8px under the bar, right edge in line with it */
    location: north east; anchor: north east;
    x-offset: -4px; y-offset: 8px;
    width:    560px;
    border:   1px; border-color: @outline;
}

mainbox  { padding: 10px; spacing: 8px; children: [ inputbar, listview ]; }

inputbar {
    background-color: transparent;
    border: 0 0 1px 0; border-color: @outline;
    padding: 8px 10px 12px 10px; spacing: 12px;
    children: [ prompt, entry ];
}
prompt   { font: "Symbols Nerd Font 15"; text-color: @primary; vertical-align: 0.5; }   /* icon from launcher.py -p */
entry    {
    placeholder: "Search, or type a number"; placeholder-color: #737aa2;
    border: 0; padding: 0; text-color: @on-surface-v;
}

listview { lines: 10; spacing: 0; scrollbar: false; fixed-height: true; cycle: true; }

element  { padding: 7px 10px; spacing: 12px; }
element normal.active, element alternate.active { background-color: #2c314a99; text-color: @on-surface-v; }
element selected.normal, element selected.active {
    background-color: #7a88cf33;
    text-color:       @on-surface-v;
    border: 0 0 0 2px; border-color: @primary;
}
element-icon { size: 24px; }
element-text { font: "Noto Sans 12"; }
