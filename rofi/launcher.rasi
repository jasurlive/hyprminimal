/* hyprminimal launcher: minimal numbered list (scripts/launcher.py). Search on top,
   one line per app, dim numbers, last used app pinned first. */
@import "theme.rasi"

configuration {
    sort:     true;      /* rank while typing: name starting with the text first (empty input keeps A-Z + recent) */
    sorting-method: "fzf";
    matching: "normal";
}

window {
    /* centred on screen, wide enough for long app names */
    location: center; anchor: center;
    x-offset: 0; y-offset: 0;
    width:    600px;
    border:   1px; border-color: @outline;
}

mainbox  { padding: 14px; spacing: 10px; children: [ inputbar, listview ]; }

inputbar {
    background-color: @surface-var;
    border: 1px; border-color: @outline;
    padding: 10px 14px; spacing: 12px;
    children: [ prompt, entry ];
}
prompt   { font: "Symbols Nerd Font 16"; text-color: @primary; vertical-align: 0.5; }   /* icon from launcher.py -p */
entry    {
    font: "Noto Sans 13";
    placeholder: "Search, type a number, or rm NAME to uninstall"; placeholder-color: #737aa2;
    border: 0; padding: 0; text-color: @on-surface-v; vertical-align: 0.5;
}

listview { lines: 8; spacing: 2px; scrollbar: false; fixed-height: true; cycle: true; }

element  { padding: 8px 12px; spacing: 14px; }
element normal.active, element alternate.active { background-color: #2c314a99; text-color: @on-surface-v; }
element selected.normal, element selected.active {
    background-color: #7a88cf33;
    text-color:       @on-surface-v;
    border: 0;
}
element-icon { size: 30px; vertical-align: 0.5; }
element-text { font: "Noto Sans 13"; vertical-align: 0.5; }
