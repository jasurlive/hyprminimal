/* hyprminimal launcher: Noctalia-style panel hanging from the top, list with
   name + description, search box at the bottom, square corners */
* {
    primary:      #7a88cf;
    on-primary:   #1f2335;
    secondary:    #d7729f;
    surface:      #1f2335e0;
    surface-var:  #2c314acc;
    on-surface:   #a9b1d6;
    on-surface-v: #c0caf5;
    outline:      #4b517a;
    error:        #f7768e;

    font:             "Noto Sans 13";
    background-color: transparent;
    text-color:       @on-surface;
    margin: 0; padding: 0; spacing: 0;
}

configuration {
    show-icons:          true;
    icon-theme:          "Yaru-blue-dark";
    hover-select:        true;
    me-select-entry:     "MousePrimary";
    me-accept-entry:     "!MousePrimary";
    sort:                true;
    sorting-method:      "fzf";
    matching:            "fuzzy";
    drun-use-desktop-cache: true;   /* skip re-parsing every .desktop file */
    drun-reload-desktop-cache: false;
}

window {
    location:         north;
    anchor:           north;
    y-offset:         4px;
    width:            1100px;
    background-color: @surface;
    border:           1px;
    border-color:     @outline;
    border-radius:    0;
}

mainbox { padding: 16px; spacing: 16px; children: [ listview, inputbar ]; }

listview {
    lines: 8; columns: 1; spacing: 2px;
    fixed-height: true; cycle: true;
    scrollbar: true;
}
scrollbar { handle-width: 4px; handle-color: @outline; background-color: transparent; }

element { padding: 8px 10px; spacing: 14px; border-radius: 0; cursor: pointer; }
element normal.normal, element alternate.normal { background-color: transparent; text-color: @on-surface-v; }
element selected.normal, element selected.active {
    background-color: @primary;
    text-color:       @on-primary;
}
element-icon { size: 46px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; markup: true; }

inputbar {
    background-color: @surface-var;
    border:           1px;
    border-color:     @outline;
    padding:          14px 18px;
    spacing:          16px;
    children:         [ avatar, entry ];
}
avatar {
    expand: false; content: "󰀄"; vertical-align: 0.5;
    font: "Symbols Nerd Font 22"; text-color: @on-surface;
}
entry {
    placeholder: "Search applications…"; placeholder-color: @on-surface;
    text-color: @on-surface-v; cursor: text;
    border: 1px; border-color: @secondary; padding: 10px 14px;
    vertical-align: 0.5;
}

message  { background-color: @surface-var; padding: 8px 12px; }
textbox  { text-color: @on-surface; }
