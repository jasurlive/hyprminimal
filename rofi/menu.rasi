/* hyprminimal session menu: compact list, top right like every hyprminimal popup (keys 1-5) */
@import "theme.rasi"

window   {
    location: north east; anchor: north east;
    x-offset: -4px; y-offset: 8px;
    width: 260px;
    border: 1px; border-color: @outline;
}
mainbox  { padding: 8px; spacing: 0; children: [ listview ]; }
listview { columns: 1; lines: 5; spacing: 2px; fixed-height: true; scrollbar: false; cycle: true; }
element  { padding: 9px 12px; spacing: 0; }
element normal.urgent, element alternate.urgent { text-color: #cf8f9a; }
element selected.normal {
    background-color: #7a88cf33; text-color: @on-surface-v;
    border: 0;
}
element selected.urgent {
    background-color: #cf8f9a33; text-color: #cf8f9a;
    border: 0;
}
element-icon { size: 0; }
element-text { font: "Noto Sans 12"; vertical-align: 0.5; }
