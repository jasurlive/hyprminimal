// hyprminimal bar: matches your active Noctalia bar
// left: workspaces | center: "15 |" 17:04 | right: media capsule, notifications, battery, network speed (busier direction)
{
  "layer": "top",
  "position": "top",
  "height": 45,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "spacing": 10,
  "reload_style_on_change": true,

  "modules-left":   ["ext/workspaces"],
  "modules-center": ["clock#date", "clock"],
  "modules-right":  ["custom/media", "custom/notification", "battery", "custom/net"],

  // optional widgets (turned on/off in hyprminimal-settings → Bar)
  "cpu":    { "cursor": true, "interval": 5, "format": "<span size='120%'>󰓅</span>  {usage}%", "on-click": "hyprminimal-msg panel system" },
  "memory": {
    "cursor": true, "interval": 5, "format": "<span size='120%'>󰍛</span>  {used:0.1f}G",
              "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB", "on-click": "hyprminimal-msg panel system" },
  "pulseaudio": {
    "cursor": true,
    "format": "<span size='120%'>{icon}</span>", "format-muted": "<span size='120%'>󰝟</span>",
    "format-icons": { "default": ["󰕾"] },
    "tooltip-format": "{desc}  {volume}%", "scroll-step": 2, "max-volume": 100,
    "on-click": "pavucontrol", "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network#wifi": {
    "cursor": true,
    "format-wifi": "<span size='120%'>{icon}</span>", "format-ethernet": "<span size='120%'>󰈀</span>",
    "format-disconnected": "<span size='120%'>󰖪</span>",
    "format-icons": ["󰖩"],
    "tooltip-format-wifi": "{essid}  {signalStrength}%", "on-click": "hyprminimal-msg panel network"
  },
  "bluetooth": {
    "cursor": true,
    "format": "<span size='120%'>󰂯</span>", "format-off": "<span size='120%'>󰂲</span>",
    "format-connected": "<span size='120%'>󰂱</span>", "on-click": "blueman-manager"
  },
  "tray": {
    "cursor": true, "icon-size": 18, "spacing": 8 },

  // ext/workspaces: clicks go through the Wayland workspace protocol, so they work with
  // Hyprland's Lua config (the hyprland/workspaces module sends old-style "dispatch workspace N")
  "ext/workspaces": {
    "cursor": true,
    "format": "{name}",
    "sort-by-name": true,
    "ignore-hidden": true,
    "on-click": "activate"
  },

  "clock#date": {
    "cursor": true, "format": "{:%d.%m %a} |", "tooltip": false, "on-click": "hyprminimal-msg panel calendar" },
  "clock": {
    "cursor": true,
    "format": "{:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months":   "<span color='#c0caf5'><b>{}</b></span>",
        "weekdays": "<span color='#7a88cf'><b>{}</b></span>",
        "today":    "<span color='#d7729f'><b><u>{}</u></b></span>"
      }
    },
    "on-click": "hyprminimal-msg panel calendar",
    "on-click-right": "hyprminimal-msg control-center"
  },

  "custom/media": {
    "cursor": true,
    "exec": "$HYPRMINIMAL_DIR/scripts/media.sh",
    "restart-interval": 2,
    "return-type": "json",
    "escape": false,
    "on-click": "hyprminimal-msg panel media",
    "on-click-middle": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "custom/errors": {
    "cursor": true, "return-type": "json", "interval": "once", "signal": 9, "escape": true,
    "exec": "$HYPRMINIMAL_DIR/scripts/errors.sh", "on-click": "hyprminimal-msg errors"
  },

  "custom/notification": {
    "cursor": true,
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚", "none": "󰂜",
      "dnd-notification": "󰂛", "dnd-none": "󰪑",
      "inhibited-notification": "󰂚", "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "hyprminimal-msg control-center",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "battery": {
    "cursor": true,
    "interval": 30,
    // the battery outline is drawn in CSS (hyprminimal-settings), the number sits inside it
    "states": { "warning": 20, "critical": 10 },
    "format": "{capacity}",
    // linen-yellow bolt while charging, same size as the number (colour = state_bolt in colors/palette.css;
    // Pango markup can't read @define-color, so it's repeated here)
    "format-charging": "<span foreground='#e8d5a6'>󱐋</span>{capacity}",
    "format-plugged": "{capacity}",
    "tooltip-format": "{capacity}%, {timeTo}",
    "on-click": "hyprminimal-msg panel battery"
  },

  "custom/net": {
    "cursor": true,
    "exec": "$HYPRMINIMAL_DIR/scripts/netspeed.sh",
    // left inside its fixed width (see fixed_widths_css): the icon never moves
    "align": 0,
    "return-type": "json",
    "restart-interval": 2,
    "on-click": "hyprminimal-msg panel network"
  }
}
