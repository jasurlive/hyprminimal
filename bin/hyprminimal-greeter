#!/usr/bin/env bash
# hyprminimal-greeter install|uninstall|status: the hyprminimal login screen (greetd greeter with a username field).
# Shown after you log out (greetd [default_session]). Needs root: sudo hyprminimal-greeter install
# Re-run install after changing monitors. The background follows the lock screen wallpaper on its own:
# background.png belongs to you, and Settings rewrites it whenever the lock wallpaper changes.
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DEST=/usr/local/share/hyprminimal-greeter STATE=/var/cache/hyprminimal-greeter
CONF=/etc/greetd/config.toml BAK=/etc/greetd/config.toml.pre-hyprminimal-greeter
CMD="env XDG_CACHE_HOME=$STATE XDG_DATA_HOME=$STATE XDG_STATE_HOME=$STATE start-hyprland -- -c $DEST/hyprland.lua"
OWNER=${SUDO_USER:-$(stat -c %U "$DIR")}
HOMEDIR=$(getent passwd "$OWNER" | cut -d: -f6)

# write greetd's whole config: the greeter at boot and after logout, nothing else.
# Never keeps old sections: a leftover [initial_session] (autologin from another setup) would skip the
# login screen, and a leftover [default_session] can point at a greeter that is no longer installed.
# Autologin is added back on top of this only by: sudo hyprminimal-autologin enable
write_config() {
  cat > "$CONF.new" <<EOF
# hyprminimal: greetd shows the hyprminimal login screen at boot and after logout.
# Installed by: sudo bin/hyprminimal-greeter install
[terminal]
vt = 1

[default_session]
command = "$1"
user = "greeter"
EOF
  chmod 644 "$CONF.new" && mv "$CONF.new" "$CONF"
}

case ${1:-status} in
  install)
    [[ $EUID == 0 ]] || { echo "run with sudo"; exit 1; }
    install -d -m 755 "$DEST"
    install -m 644 "$DIR/greeter/greeter.py" "$DIR/greeter/style.css" "$DIR/greeter/hyprland.lua" \
      "$DIR/greeter/fast-exit.sh" "$DEST/"
    # themed copy from Settings -> General -> Theme
    [[ -f $DIR/.generated/greeter.css ]] && install -m 644 "$DIR/.generated/greeter.css" "$DEST/style.css"
    [[ -f $HOMEDIR/.config/hypr/monitors.lua ]] && install -m 644 "$HOMEDIR/.config/hypr/monitors.lua" "$DEST/"
    # wallpaper from the lock screen config, pre-blurred and dimmed like hyprlock. Owned by you, so
    # Settings can redo it when the lock wallpaper changes (sync_greeter_background)
    lock="$DIR/.generated/hyprlock.conf"; [[ -f $lock ]] || lock="$DIR/hyprlock/hyprlock.conf"
    wp=$(awk -F' *= *' '/^[[:space:]]*path *=/ { print $2; exit }' "$lock"); wp=${wp/#\~/$HOMEDIR}
    if [[ -f $wp ]] && magick "$wp" -resize 2560x1440^ -gravity center -extent 2560x1440 -blur 0x24 \
                         -modulate 70,120 "$DEST/background.png"; then
      chown "$OWNER" "$DEST/background.png"; chmod 644 "$DEST/background.png"
      printf '%s\n' "$wp" > "$DIR/.generated/greeter_wall" 2>/dev/null && chown "$OWNER" "$DIR/.generated/greeter_wall"
      echo "greeter background: $wp"
    else
      echo "warning: could not make a background from '$wp', using a plain one"; rm -f "$DEST/background.png"
    fi
    install -d -m 755 -o greeter -g greeter "$STATE"
    [[ -f $CONF && ! -f $BAK ]] && cp -p "$CONF" "$BAK"
    grep -q '^\[initial_session\]' "$CONF" 2>/dev/null && echo "note: removed autologin ([initial_session]) from $CONF"
    write_config "$CMD"
    echo "greeter installed. Reboot or log out to see it. Undo: sudo $0 uninstall" ;;
  uninstall)
    [[ $EUID == 0 ]] || { echo "run with sudo"; exit 1; }
    if [[ -f $BAK ]]; then cp -p "$BAK" "$CONF" && rm -f "$BAK"; fi
    rm -rf "$DEST" "$STATE"
    echo "greeter removed, previous greetd config restored" ;;
  status)
    grep -q "$DEST" "$CONF" && echo "greeter: installed" || echo "greeter: not installed" ;;
  *) echo "usage: $0 install|uninstall|status"; exit 2 ;;
esac
