#!/usr/bin/env bash
# hyprminimal: run the hyprminimal shell inside the running Hyprland.
#   hyprminimal start          start hyprminimal (stops a running copy first)
#   hyprminimal stop           stop hyprminimal
#   hyprminimal restart        restart hyprminimal (after editing configs)
#   hyprminimal respawn NAME   restart one component (waybar panels)
#   hyprminimal status         show what is running, its memory (PSS), and any missing packages
#   hyprminimal build          build the C helpers (helpers/*.c) that are older than their source
set -uo pipefail
# never pass a GTK4 LD_PRELOAD on to waybar (GTK3): it crashes at start
unset LD_PRELOAD

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
RUN="${XDG_RUNTIME_DIR:-/tmp}/hyprminimal"
GEN="$DIR/.generated"   # rendered from settings.json by hyprminimal-settings --apply (helpers/panels.c)
GOOD="$GEN/good"        # last config each component ran on without crashing
ERR="$RUN/errors"       # ERR/NAME: why a component failed; the bar shows a red pill, Settings a red banner
export PATH="$DIR/bin:$PATH" HYPRMINIMAL_DIR="$DIR"

# panels: helpers/panels.c, everything on screen but the bar: popups, control center, notifications, OSD
COMPONENTS=(waybar panels)
declare -A LOG=([waybar]=waybar [panels]=panels)
declare -A NAME=([waybar]="Bar" [panels]="Popups, notifications and OSD")
declare -A CONF=([waybar]="waybar.json waybar.css")
declare -A FIX=([waybar]="Check Settings → Bar, or waybar/config.jsonc and waybar/style.css."
                [panels]="Check helpers/panels.c and helpers/panels/ (build log: $RUN/helpers-build.log).")

# previous log kept as NAME.log.1 so a crash reason survives the restart
spawn() { local name=$1; shift; [[ -s $RUN/$name.log ]] && mv -f "$RUN/$name.log" "$RUN/$name.log.1"
          ( unlock_fd; exec setsid -f "$@" >"$RUN/$name.log" 2>&1 </dev/null ); }
# started programs must not inherit the respawn lock (see with_lock), or it is never released
unlock_fd() { [[ ${LOCKFD:-} ]] && eval "exec ${LOCKFD}>&-"; return 0; }

# desktop notification, only when a notification daemon (normally ours, helpers/panels.c) is running:
# never D-Bus-activate another one
notify() {  # urgency title body
  busctl --user list 2>/dev/null | grep -q "^org.freedesktop.Notifications " || { echo "hyprminimal: $2: $3" >&2; return; }
  notify-send -a hyprminimal -i dialog-warning -u "$1" "$2" "$3" 2>/dev/null
}

# rendered config file to start NAME with: the last working copy while NAME is in fallback
cfg() { local c=$1 f=$2; [[ -e $RUN/fallback/$c && -f $GOOD/$f ]] && echo "$GOOD/$f" || echo "$GEN/$f"; }

set_error() {   # NAME message: remember the failure and refresh the bar's error pill
  mkdir -p "$ERR"; printf '%s\n' "$2" >"$ERR/$1"; pkill -RTMIN+9 -x waybar
}
clear_error() { [[ -e $ERR/$1 ]] && { rm -f "$ERR/$1"; pkill -RTMIN+9 -x waybar; }; return 0; }

# A layer surface that maps while a window is already fullscreen is drawn ON TOP of it (Hyprland 0.57):
# a bar (re)started then (login race with an autostarted fullscreen app, Settings apply, watchdog restart)
# covers the fullscreen window. Once the bar is up, toggle every real fullscreen window (mode 2; mode 1 =
# maximized leaves room for the bar) off and on again: re-entering fullscreen puts it back above the bar.
refullscreen_after_bar() {
  ( unlock_fd
    for _ in $(seq 50); do hyprctl layers 2>/dev/null | grep -q 'namespace: waybar' && break; sleep 0.1; done
    sleep 0.2
    hyprctl clients 2>/dev/null | awk '/^Window /{a="0x"$2} /^\tfullscreen: 2$/{print a}' | while read -r a; do
      hyprctl dispatch "hl.dsp.window.fullscreen({ window = \"address:$a\" })" >/dev/null
      hyprctl dispatch "hl.dsp.window.fullscreen({ window = \"address:$a\" })" >/dev/null
    done ) </dev/null >/dev/null 2>&1 &
  disown
}

start_one() {   # start a single component (not running already)
  case $1 in
    waybar)
      spawn waybar waybar -c "$(cfg waybar waybar.json)" -s "$(cfg waybar waybar.css)"
      refullscreen_after_bar ;;
    panels)
      build_report   # respawn after an edit runs the new code (nothing to do when it is up to date)
      if [[ ! -x $GEN/bin/panels ]]; then
        notify critical "Popups, notifications and OSD unavailable" \
          "Building helpers/panels.c failed (needs gcc, gtk4 and gtk4-layer-shell). Details: $RUN/helpers-build.log"
        return 1
      fi
      spawn panels "$GEN/bin/panels"
      # wait for it on the bus: notifications sent before that would get no daemon
      for _ in $(seq 30); do busctl --user list 2>/dev/null | grep -q "^dev.hyprminimal.Panels " && break; sleep 0.1; done ;;
    *) echo "hyprminimal: unknown component $1" >&2; return 2 ;;
  esac
}

stop_one() {
  pkill -x "$1"
  for _ in $(seq 20); do pgrep -x "$1" >/dev/null || break; sleep 0.05; done
}

# small C helpers (helpers/*.c -> .generated/bin/), rebuilt when the source is newer. A first line
# "// pkg-config: lib ..." adds those libraries (the GTK bar popups, helpers/panels.c). gcc is required
# (packages.txt): there are no script fallbacks for the popups or the watchdog's waitpids.
# Fails when any helper fails to build: its old binary (if any) stays, so callers that only need one to
# exist go on with it.
build_helpers() {
  local src out libs flags rc=0
  mkdir -p "$GEN/bin"
  for src in "$DIR"/helpers/*.c; do
    out="$GEN/bin/$(basename "$src" .c)"
    # helpers/NAME/*.c are #included by helpers/NAME.c: a change there rebuilds it too
    [[ $out -nt $src && -z $(find "$DIR/helpers/$(basename "$src" .c)" -name '*.c' -newer "$out" 2>/dev/null) ]] && continue
    flags=()
    read -r libs < "$src"
    if [[ $libs == "// pkg-config: "* ]]; then
      libs=${libs#// pkg-config: }
      flags=($(pkg-config --cflags --libs $libs 2>>"$RUN/helpers-build.log") -lm) || { rc=1; continue; }
    fi
    gcc -O2 -Wall -o "$out.tmp" "$src" "${flags[@]}" 2>>"$RUN/helpers-build.log" && mv -f "$out.tmp" "$out" \
      || { rm -f "$out.tmp"; rc=1; }
  done
  return $rc
}

# build_helpers, with a failure on the bar's red error pill. Its own error name: the watchdog clears
# errors/panels once panels has run 5 s, and a stale binary runs fine.
build_report() {
  if build_helpers; then clear_error build
  else set_error build "building the C helpers failed, running the last built version: $RUN/helpers-build.log"; fi
}

# bar popups (calendar, battery, network, Wi-Fi list, system) + clock click strip: helpers/panels.c, resident
panels_quit() {
  gdbus call --session --dest dev.hyprminimal.Panels --object-path /dev/hyprminimal/Panels \
    --method org.gtk.Actions.Activate quit "[]" "{}" >/dev/null 2>&1
  for _ in $(seq 20); do pgrep -f "^$GEN/bin/panels" >/dev/null || break; sleep 0.05; done
}

restart_one() { stop_one "$1"; start_one "$1"; }
ensure_one() { pgrep -x "$1" >/dev/null && return 1; start_one "$1"; }

# one component at a time: settings reloads and the watchdog never start it twice
with_lock() {
  local name=$1 rc; shift
  exec {LOCKFD}>"$RUN/$name.lock"; flock "$LOCKFD"
  "$@"; rc=$?
  exec {LOCKFD}>&-; LOCKFD=""
  return $rc
}

# last meaningful error line of a component's log (skips GTK theme noise)
why() {
  local f="$RUN/${LOG[$1]}.log" line sig
  sig=$(coredumpctl --no-pager -q list --since=-30s "$(command -v "$1")" 2>/dev/null | awk '$(NF-3) ~ /^SIG/ {s=$(NF-3)} END {print s}')
  line=$(grep -aiE 'error|critical|fail|panic|abort|segmentation|invalid|unknown|cannot|not found' "$f" 2>/dev/null \
         | grep -viE 'Theme parser error|DispatchNotifier|gtk_icon_theme_lookup' | tail -2 \
         | sed -E 's/^\[[^]]*\] *//; s/^\([^)]*\): *//; s/^ +//' | paste -sd' ' | cut -c1-240)
  if [[ $sig == SIG* ]]; then echo "crashed ($sig)${line:+. Last error: $line}"
  elif [[ $line ]]; then echo "$line"
  else echo "exited without an error message"; fi
}

# config of NAME differs from its last working copy (so falling back to that copy can help)
config_changed() {
  local f; for f in ${CONF[$1]:-}; do [[ -f $GOOD/$f ]] && ! cmp -s "$GEN/$f" "$GOOD/$f" && return 0; done; return 1
}

# NAME runs on a config it hasn't proven yet (new settings, or it had an error): mark_good still has work
unproven() {
  local c=$1 f
  [[ -e $RUN/fallback/$c ]] && return 1
  [[ -e $ERR/$c ]] && return 0
  for f in ${CONF[$c]:-}; do [[ $GEN/$f -nt $GOOD/$f ]] && return 0; done
  return 1
}

# NAME has run 5 s on the current config: keep that config as the last working one, clear its error
mark_good() {
  local c=$1 pid=$2 f
  unproven "$c" || return
  local up; up=$(ps -o etimes= -p "$pid" 2>/dev/null) || return
  (( ${up:-0} >= 5 )) || return
  mkdir -p "$GOOD"; for f in ${CONF[$c]:-}; do cp -p "$GEN/$f" "$GOOD/$f"; done
  clear_error "$c"
}

# watchdog: restart dead components and say why. A component that dies on new settings goes back to its
# last working config (the rest of the shell is untouched) and shows a red error in the bar and Settings;
# one that keeps dying anyway is left stopped, with the reason and what to fix.
# Event-driven: between rounds it blocks in waitpids (helpers/waitpids.c) until a component exits, so it
# costs nothing while everything runs. It wakes on a timer only while something needs a second look.
watchdog() {
  declare -A hits gave pid
  local now c reason pat t again waiter="$GEN/bin/waitpids"
  pat="$(IFS='|'; echo "${COMPONENTS[*]}")"
  while [[ -e $RUN/active ]]; do
    now=$EPOCHSECONDS
    pid=() again=""
    while read -r p n; do pid[$n]=$p; done < <(pgrep -x -l "$pat")   # one process scan per round
    for c in "${COMPONENTS[@]}"; do
      if [[ ${pid[$c]:-} ]]; then gave[$c]=""; mark_good "$c" "${pid[$c]}"; continue; fi
      [[ ${gave[$c]:-} ]] && continue
      again=1
      # being restarted right now (Settings applying new values holds its lock): not a crash
      flock -n "$RUN/$c.lock" true 2>/dev/null || continue
      reason=$(why "$c")
      if [[ ! -e $RUN/fallback/$c ]] && config_changed "$c"; then
        mkdir -p "$RUN/fallback"; touch "$RUN/fallback/$c"
        set_error "$c" "$reason — running on your last working settings"
        with_lock "$c" ensure_one "$c"
        notify critical "${NAME[$c]} failed on the new settings" \
          "$reason
Went back to the last working settings; the rest of hyprminimal is unaffected. ${FIX[$c]}"
        continue
      fi
      local recent=() t0
      for t0 in ${hits[$c]:-}; do (( now - t0 < 60 )) && recent+=("$t0"); done
      recent+=("$now"); hits[$c]="${recent[*]}"
      if (( ${#recent[@]} >= 3 )); then
        gave[$c]=1
        set_error "$c" "$reason — stopped after 3 crashes"
        notify critical "${NAME[$c]} keeps crashing, stopped restarting it" \
          "$reason
${FIX[$c]}
Log: $RUN/${LOG[$c]}.log — after fixing run: hyprminimal restart"
        continue
      fi
      with_lock "$c" ensure_one "$c" || continue   # 1 = someone restarted it meanwhile
      sleep 1
      if pgrep -x "$c" >/dev/null; then
        notify normal "${NAME[$c]} stopped, restarted it" "$reason"
      fi
    done
    if [[ $again || ${#pid[@]} -eq 0 ]]; then sleep 3; continue; fi   # something changed: look again soon
    t=-1
    for c in "${!pid[@]}"; do unproven "$c" && t=6000; done     # mark_good needs a look after 5 s of uptime
    for c in "${!gave[@]}"; do [[ ${gave[$c]} ]] && t=30000; done  # notice a stopped one restarted by hand
    "$waiter" "$t" "${pid[@]}" || [[ $? == 1 ]] || sleep 3       # 2 = error (or not built): don't spin
    sleep 1   # an exit is often a restart in progress (Settings applying new values): let it finish
  done
}

stop_components() {
  # nothing of ours running (fresh login): skip ~20 pkill/pgrep scans and the settle sleep (~1 s)
  pgrep -x "$(IFS='|'; echo "${COMPONENTS[*]}|hyprsunset|waitpids")" >/dev/null \
    || pgrep -f "$DIR/bin/hyprminimal watchdog" >/dev/null \
    || { [[ -f $RUN/caffeine.pid ]] && kill "$(cat "$RUN/caffeine.pid")" 2>/dev/null; rm -f "$RUN/caffeine.pid"; return 0; }
  pkill -f "$DIR/bin/hyprminimal watchdog"; pkill -f "$GEN/bin/waitpids"
  for c in "${COMPONENTS[@]}"; do stop_one "$c"; done
  pkill -x hyprsunset
  pkill -x swaync; pkill -x swayosd-server   # older hyprminimal ran these; helpers/panels.c does both now
  pkill -x swaybg   # older hyprminimal drew the wallpaper with it; helpers/panels.c draws the desktop now
  [[ -f $RUN/caffeine.pid ]] && kill "$(cat "$RUN/caffeine.pid")" 2>/dev/null; rm -f "$RUN/caffeine.pid"
  sleep 0.3
}

start_components() {
  local err stamp="$GEN/.applied"
  build_report   # first: the render below is helpers/panels.c (panels --apply)
  # re-render only when settings.json or a repo config changed since the last render.
  # HYPRMINIMAL_FORCE_APPLY=1 renders anyway.
  if [[ ${HYPRMINIMAL_FORCE_APPLY:-} || ! -f $stamp ]] \
     || [[ $(find "$DIR" \( -path "$GEN" -o -path "$DIR/.git" \) -prune -o -newer "$stamp" -print -quit 2>/dev/null) ]]; then
    if err=$("$GEN/bin/panels" --apply 2>&1); then touch "$stamp"
    else RENDER_ERR=${err##*$'\n'}; rm -f "$stamp"; fi   # reported once panels is up
  fi
  local nl temp
  read -r nl temp < "$GEN/nightlight" 2>/dev/null
  # helpers/panels.c is the notification daemon: if swaync is still installed, keep its user unit masked so
  # D-Bus can't start it whenever a notification arrives while panels restarts (undo: systemctl --user unmask swaync.service)
  [[ -e /usr/lib/systemd/user/swaync.service && $(systemctl --user is-enabled swaync.service 2>/dev/null) != masked ]] \
    && systemctl --user mask -q swaync.service
  # panels first: it owns the notification bus name and writes the state the bar's bell shows
  start_one panels
  start_one waybar
  # one "current player" for bar, panel and media keys (several Firefox tabs = several players)
  pgrep -x playerctld >/dev/null || spawn playerctld playerctld daemon
  [[ ${nl:-} == on ]] && spawn hyprsunset hyprsunset -t "${temp:-4000}"
  if [[ ${RENDER_ERR:-} ]]; then set_error settings "Settings could not be applied: $RENDER_ERR"; else clear_error settings; fi
  [[ ${RENDER_ERR:-} ]] && notify critical "hyprminimal: settings could not be applied" \
    "$RENDER_ERR
Using the last working files. Check settings.json (or reopen Settings and change the value back)."
  setsid -f "$DIR/bin/hyprminimal" watchdog >"$RUN/watchdog.log" 2>&1 </dev/null
}

# Settings → Startup: user commands, once per Hyprland session, so hyprminimal restart / stop+start never
# launch them twice. The marker holds the Hyprland instance it ran in: XDG_RUNTIME_DIR is NOT cleared on
# logout while the user's systemd manager lives on (quick re-login), so a bare "done" file would survive
# a log out / log in and skip the commands.
run_startup() {
  local sig=${HYPRLAND_INSTANCE_SIGNATURE:-no-hyprland}
  [[ $(cat "$RUN/startup.done" 2>/dev/null) == "$sig" ]] && return
  printf '%s\n' "$sig" >"$RUN/startup.done"
  # Bluetooth is off at every login (install.sh also sets AutoEnable=false); hyprminimal restart keeps
  # whatever you switched on. In the background: bluetoothctl can take a moment while bluetoothd starts.
  ( unlock_fd; systemctl is-active -q bluetooth && timeout 5 bluetoothctl power off ) >/dev/null 2>&1 </dev/null &
  disown
  local cmd
  while IFS= read -r cmd; do
    [[ $cmd ]] || continue
    echo "[$(date +%T)] $cmd" >>"$RUN/startup.log"
    ( cd "$HOME" && setsid -f sh -c "$cmd" >>"$RUN/startup.log" 2>&1 </dev/null )
  done < "$GEN/startup" 2>/dev/null
}

case ${1:-} in
  start)
    mkdir -p "$RUN"; touch "$RUN/active"; rm -rf "$RUN/fallback" "$ERR"
    stop_components; start_components
    run_startup
    echo "hyprminimal started (logs: $RUN)"
    ;;
  stop)
    rm -f "$RUN/active"
    stop_components
    panels_quit
    echo "hyprminimal stopped"
    ;;
  restart)
    [[ -e $RUN/active ]] || { echo "hyprminimal is not active"; exit 1; }
    panels_quit                    # rebuilt from helpers/panels.c if it changed, then started again
    rm -rf "$RUN/fallback" "$ERR"
    stop_components; start_components; echo "hyprminimal restarted"
    ;;
  respawn)
    [[ -e $RUN/active ]] || exit 0
    c=${2:-}; [[ -n ${LOG[$c]:-} ]] || { echo "usage: hyprminimal respawn ${COMPONENTS[*]}"; exit 2; }
    rm -f "$RUN/fallback/$c"; clear_error "$c"   # new settings: try them (the watchdog falls back if they fail)
    with_lock "$c" restart_one "$c"
    ;;
  watchdog) watchdog ;;
  build)
    mkdir -p "$RUN"
    build_helpers || { echo "building the C helpers failed: $RUN/helpers-build.log" >&2; exit 1; }
    ;;
  status)
    [[ -e $RUN/active ]] && echo "hyprminimal: active" || echo "hyprminimal: stopped"
    # every process hyprminimal runs, with its PSS (/proc/PID/smaps_rollup): shared pages such as the GTK
    # libraries are split between the processes using them, so the total is honest (RSS counts them in each)
    rows=(
      "waybar|-x waybar" "panels|-f ^$GEN/bin/panels"
      "playerctld|-x playerctld" "hyprsunset|-x hyprsunset" "watchdog|-f $DIR/bin/hyprminimal watchdog"
      "media|-f ^$GEN/bin/media" "waitpids|-f ^$GEN/bin/waitpids"
    )
    total=0 procs=0
    printf '  %-15s %-8s %8s\n' component state PSS
    for r in "${rows[@]}"; do
      c=${r%%|*}; read -r how pat <<<"${r#*|}"
      mapfile -t pids < <(pgrep "$how" "$pat")
      kb=0; for p in "${pids[@]}"; do v=$(awk '/^Pss:/{print $2}' "/proc/$p/smaps_rollup" 2>/dev/null) && kb=$(( kb + ${v:-0} )); done
      if (( ${#pids[@]} )); then state=running; mem=$(awk -v k="$kb" 'BEGIN{printf "%.1f MB", k/1024}')
      else state=-; mem=; fi
      (( total += kb, procs += ${#pids[@]} ))
      printf '  %-15s %-8s %8s%s\n' "$c" "$state" "$mem" "$([[ -e $RUN/fallback/$c ]] && echo ' (last working settings)')"
    done
    printf '  %-15s %-8s %8s\n' total "$procs proc" "$(awk -v k="$total" 'BEGIN{printf "%.1f MB", k/1024}')"
    for f in "$ERR"/*; do [[ -f $f ]] && printf 'error %s: %s\n' "${f##*/}" "$(<"$f")"; done
    # packages are checked here and by install.sh, not at every login: one pacman call for the whole list
    mapfile -t miss < <(pacman -T $(awk '!/^[[:space:]]*#/ && NF {print $1}' "$DIR/packages.txt") 2>/dev/null)
    (( ${#miss[@]} )) && printf 'missing packages: %s\n  sudo pacman -S --needed %s\n' "${miss[*]}" "${miss[*]}"
    exit 0
    ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
