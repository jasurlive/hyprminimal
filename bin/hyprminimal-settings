#!/usr/bin/env bash
# hyprminimal settings: the Settings window is part of the resident panels program (helpers/panels.c).
#   hyprminimal-settings                 open Settings on the page shown last
#   hyprminimal-settings --page NAME     open on a page: general, bar, notifications, startup, network,
#                                        nightlight, keybinds, system, about
#   hyprminimal-settings --apply         regenerate .generated/* from settings.json (no window)
#   hyprminimal-settings --toggle-bar    flip Bar → Hide bar and regenerate (Super+M signals waybar itself)
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PANELS="$DIR/.generated/bin/panels"
case ${1:-} in
  -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --apply|--toggle-bar)
    "$DIR/bin/hyprminimal" build || exit 1   # rebuilds panels when its source is newer
    exec "$PANELS" "$1" ;;
esac
page=last   # no --page: reopen on the page shown last
[[ ${1:-} == --page && -n ${2:-} ]] && page=$2
[[ $page =~ ^[a-z]+$ ]] || page=last
# running (the usual case): ask it over D-Bus, ~10 ms
gdbus call --session --dest dev.hyprminimal.Panels --object-path /dev/hyprminimal/Panels \
  --method org.gtk.Actions.Activate settings "[<'$page'>]" "{}" >/dev/null 2>&1 && exit 0
[[ -x $PANELS ]] || "$DIR/bin/hyprminimal" build || exit 1
exec setsid -f "$PANELS" --settings "$page" >/dev/null 2>&1 </dev/null
