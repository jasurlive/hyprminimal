#!/usr/bin/env bash
# Shell actions for your Hyprland keybinds (launcher, lock, media, OSD, panels, ...).
SELF=$(readlink -f "${BASH_SOURCE[0]}"); DIR=${SELF%/bin/*}   # one fork: this runs on every key press
export PATH="$DIR/bin:$PATH" HYPRMINIMAL_DIR="$DIR"
cmd=${1:-}; shift
# action on the bar popup program (helpers/panels.c); fails fast when it isn't running
panels_call() { gdbus call --session --dest dev.hyprminimal.Panels --object-path /dev/hyprminimal/Panels \
                  --method org.gtk.Actions.Activate "$1" "$2" "{}" >/dev/null 2>&1; }

case $cmd in
  launcher|session) # Super+R, the session menu: resident popups in helpers/panels.c (instant);
                  # not running (yet): start it, it opens the popup itself
                  panels_call panel "[<'$cmd'>]" && exit 0
                  exec setsid -f "$DIR/.generated/bin/panels" --panel "$cmd" >/dev/null 2>&1 </dev/null ;;
  lock)           # hyprlock can crash on resume (AMD/Mesa abort when the screen comes back), which leaves
                  # Hyprland's red "lockscreen app died" page. Hyprland lets a new locker take over the
                  # lock (misc.allow_session_lock_restore), so restart hyprlock until it exits 0 (= unlocked).
                  conf="$DIR/.generated/hyprlock.conf"; [[ -f $conf ]] || conf="$DIR/hyprlock/hyprlock.conf"
                  R=${XDG_RUNTIME_DIR:-/tmp}/hyprminimal; mkdir -p "$R"
                  exec 9>"$R/lock.lock"; flock -n 9 || exit 0   # one supervisor (keybind + menu)
                  pidof hyprlock >/dev/null && exit 0
                  for (( tries = 0; tries < 20; tries++ )); do
                    hyprlock -c "$conf" 9>&- && exit 0
                    rc=$?; echo "[$(date +%T)] hyprlock exited with $rc, restarting" >> "$R/hyprlock.log"
                    sleep 0.5
                  done ;;
  control-center) panels_call panel "[<'control'>]" ;;   # Super+S, the bell, the media capsule: helpers/panels.c
  dnd)            # Do not disturb: on | off | toggle (bar bell right click, Settings → Notifications)
                  [[ ${1:-toggle} =~ ^(on|off|toggle)$ ]] || exit 2
                  panels_call dnd "[<'${1:-toggle}'>]" ;;
  panel)          # calendar | battery | network | wifi | system | launcher | session | control: helpers/panels.c
                  [[ ${1:-} =~ ^[a-z]+$ ]] || exit 2
                  panels_call panel "[<'$1'>]" && exit 0
                  # not running (yet): start it; it toggles the popup itself
                  [[ -x $DIR/.generated/bin/panels ]] && exec setsid -f "$DIR/.generated/bin/panels" --panel "$1" >/dev/null 2>&1 </dev/null
                  notify-send -a hyprminimal -u critical "Bar popups unavailable" \
                    "helpers/panels.c isn't built yet: run hyprminimal restart (needs gcc, gtk4, gtk4-layer-shell)" ;;
  panel-close)    # close the open bar popup (sent by Hyprland on a click outside it, see hypr/layerrules.lua)
                  panels_call panel-close "[]" ;;
  settings-close) # hide the Settings window (Hyprland, on a click outside it: hypr/layerrules.lua)
                  panels_call settings-close "[]" ;;
  media)
    case ${1:-toggle} in toggle) exec playerctl play-pause ;; *) exec playerctl "$1" ;; esac ;;
  volume)         # $1 = +N | -N | mute: changed and shown by the OSD in helpers/panels.c (wpctl when it isn't running)
                  [[ ${1:-} =~ ^([+-][0-9]+|mute)$ ]] || exit 2
                  panels_call osd "[<'volume:$1'>]" && exit 0
                  if [[ $1 == mute ]]; then exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; fi
                  exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "${1#[+-]}%${1:0:1}" ;;
  brightness)     # $1 = +N | -N, through the OSD (it sets the backlight via logind)
                  [[ ${1:-} =~ ^[+-][0-9]+$ ]] || exit 2
                  panels_call osd "[<'brightness:$1'>]" ;;
  caffeine)       # block idle, sleep and lid-close until toggled off
    R=${XDG_RUNTIME_DIR:-/tmp}/hyprminimal
    if [[ -f $R/caffeine.pid ]] && kill "$(cat "$R/caffeine.pid")" 2>/dev/null; then rm -f "$R/caffeine.pid"
    else setsid systemd-inhibit --what=idle:sleep:handle-lid-switch --who=hyprminimal --why=Caffeine sleep infinity >/dev/null 2>&1 </dev/null &
         echo $! > "$R/caffeine.pid"; fi ;;
  caffeine-state) R=${XDG_RUNTIME_DIR:-/tmp}/hyprminimal
                  [[ -f $R/caffeine.pid ]] && kill -0 "$(cat "$R/caffeine.pid")" 2>/dev/null && echo true || echo false ;;
  nightlight)     read -r _ temp < "$DIR/.generated/nightlight" 2>/dev/null
                  pkill -x hyprsunset || setsid -f hyprsunset -t "${temp:-4000}" >/dev/null 2>&1 ;;
  bluetooth)      # control center toggle: $1 = on | off. bluetoothctl hangs without bluetoothd
                  systemctl is-active -q bluetooth || exit 0
                  [[ ${1:-} == on ]] && exec timeout 2 bluetoothctl power on >/dev/null
                  exec timeout 2 bluetoothctl power off >/dev/null ;;
  bluetooth-state) systemctl is-active -q bluetooth && timeout 1 bluetoothctl show 2>/dev/null | grep -q "Powered: yes" \
                     && echo true || echo false ;;
  nightlight-state) pgrep -x hyprsunset >/dev/null && echo true || echo false ;;
  settings)       # Super+I: toggle the Settings window (helpers/panels.c; started when it isn't running)
                  panels_call settings "[<'toggle'>]" && exit 0
                  exec "$DIR/bin/hyprminimal-settings" ;;
  errors)         # bar error pill: open Settings on the page of the first failed part
                  declare -A P=([waybar]=bar [panels]=notifications [settings]=general)
                  page=general
                  for f in "${XDG_RUNTIME_DIR:-/tmp}"/hyprminimal/errors/*; do [[ -f $f ]] && { page=${P[${f##*/}]:-general}; break; }; done
                  exec "$DIR/bin/hyprminimal-settings" --page "$page" ;;
  bar)            # Super+M: show/hide the bar now (waybar SIGUSR1, no restart; pidof ~10 ms vs pkill ~60),
                  # then save it (Settings → Bar → Hide bar) so the bar starts that way next time
                  pid=$(pidof -s waybar) && kill -USR1 "$pid"
                  panels_call bar-toggled "[]" && exit 0
                  exec "$DIR/bin/hyprminimal-settings" --toggle-bar ;;
  cheatsheet)     exec "$DIR/bin/hyprminimal-settings" --page keybinds ;;
esac
